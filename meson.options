option('xwayland', type: 'feature', value: 'auto', description: 'Support X11 clients through XWayland')
option('portal', type: 'feature', value: 'auto', description: 'Portal backend and notifications over D-Bus (sd-bus: libsystemd, or basu)')
option('lock', type: 'feature', value: 'auto', description: 'The lock screen and the greeter, through PAM (D-12)')
option('chkpwd', type: 'feature', value: 'auto', description: 'twm-chkpwd, setuid root, for the lock where PAM cannot check a password unprivileged (auto: not with Linux-PAM)')
option('tests', type: 'boolean', value: true, description: 'Build unit and screenshot tests')
